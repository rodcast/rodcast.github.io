{
  "openapi": "3.1.0",
  "info": {
    "title": "Rodrigo Castilho Public Site API",
    "version": "1.0.0",
    "description": "Profile and content are published as static HTML, Markdown, and RSS. This OpenAPI contract describes the static health probe."
  },
  "servers": [
    {
      "url": "https://rodrigocastilho.com"
    }
  ],
  "paths": {
    "/api/health.json": {
      "get": {
        "summary": "Health probe",
        "responses": {
          "200": {
            "description": "Static health status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "deprecated": true,
        "summary": "Legacy extensionless health probe",
        "responses": {
          "200": {
            "description": "Legacy static health status; use /api/health.json for a JSON media type"
          }
        }
      }
    }
  }
}
