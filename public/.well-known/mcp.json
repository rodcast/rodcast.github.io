{
  "protocol_version": "2024-05-15",
  "name": "rodrigo-castilho-public-site",
  "version": "0.2.1",
  "description": "Static discovery metadata for the Rodrigo Castilho personal website. WebMCP browser tools expose public profile information plus rendered GitHub repositories and Medium articles.",
  "author": "Rodrigo Castilho",
  "schemas": {
    "github": {
      "$schema": "https://json-schema.org/draft-07/schema#",
      "description": "Normalized GitHub repository metadata (IGitHub)",
      "type": "object",
      "required": ["node_id", "name", "html_url", "description", "updated_at"],
      "properties": {
        "node_id": { "type": "string" },
        "name": { "type": "string" },
        "html_url": { "type": "string" },
        "description": { "type": "string" },
        "updated_at": { "type": "string" },
        "is_private": { "type": "boolean" },
        "fork": { "type": "boolean" }
      }
    },
    "medium": {
      "$schema": "https://json-schema.org/draft-07/schema#",
      "description": "Normalized Medium article metadata (IMedium)",
      "type": "object",
      "required": ["guid", "title", "link", "pubDate", "content"],
      "properties": {
        "guid": { "type": "string" },
        "title": { "type": "string" },
        "link": { "type": "string" },
        "pubDate": { "type": "integer" },
        "content": { "type": "string" }
      }
    },
    "webmcp_github_project": {
      "$schema": "https://json-schema.org/draft-07/schema#",
      "description": "Project summary returned by the WebMCP list-github-projects tool",
      "type": "object",
      "required": ["name", "url", "description"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "webmcp_medium_article": {
      "$schema": "https://json-schema.org/draft-07/schema#",
      "description": "Article summary returned by the WebMCP list-medium-articles tool",
      "type": "object",
      "required": ["title", "url", "publishedAt", "summary"],
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "publishedAt": { "type": "string" },
        "summary": { "type": "string" }
      }
    }
  },
  "capabilities": [
    {
      "id": "get-profile-summary",
      "name": "Get Profile Summary",
      "description": "Return the rendered profile name, description, and social links.",
      "endpoint": "https://rodrigocastilho.com/"
    },
    {
      "id": "navigate-to-section",
      "name": "Navigate to Section",
      "description": "Navigate to the about, projects, or articles section."
    },
    {
      "id": "list-github-projects",
      "name": "List GitHub Projects",
      "description": "List public GitHub repositories rendered on the page.",
      "schema_ref": "#/schemas/webmcp_github_project"
    },
    {
      "id": "list-medium-articles",
      "name": "List Medium Articles",
      "description": "List Medium articles rendered on the page.",
      "schema_ref": "#/schemas/webmcp_medium_article"
    }
  ],
  "discovery": {
    "api_catalog": "https://rodrigocastilho.com/.well-known/api-catalog.json",
    "openapi": "https://rodrigocastilho.com/docs/api/openapi.json",
    "agent_skills": "https://rodrigocastilho.com/.well-known/agent-skills/index.json",
    "mcp_server_card": "https://rodrigocastilho.com/.well-known/mcp/server-card.json"
  }
}
